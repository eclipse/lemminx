<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="servlet">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="servlet-name" type="xs:string" />
				<xs:choice>
					<xs:element name="servlet-class" type="xs:string" />
					<xs:element name="jsp-file" type="xs:string" />
				</xs:choice>
				<xs:element name="load-on-startup" type="xs:int" minOccurs="0" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
