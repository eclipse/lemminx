<!ELEMENT book (chapter+)>
<!ATTLIST book
  title CDATA #REQUIRED
  isbn CDATA #REQUIRED
  edition CDATA #IMPLIED
>

<!ELEMENT chapter (section*)>
<!ATTLIST chapter
  id ID #REQUIRED
  title CDATA #REQUIRED
>

<!ELEMENT section (#PCDATA)>
<!ATTLIST section
  name CDATA #REQUIRED
  level CDATA #IMPLIED
>
